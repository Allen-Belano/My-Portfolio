{
  "name": "my-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run check:site && npm run test:unit",
    "check:site": "node scripts/quality-checks.mjs",
    "check:js": "node --check index.js",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.test.mjs\"",
    "test": "npm run check && npm run test:browser"
  },
  "devDependencies": {
    "gsap": "3.12.5",
    "lenis": "1.1.9",
    "playwright": "1.63.0"
  }
}
